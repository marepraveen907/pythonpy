class Solution(object):
    def findSubstring(self, s, words):
        if not s or not words:
            return []

        w, k = len(words[0]), len(words)
        need = {}
        for word in words:
            need[word] = need.get(word, 0) + 1

        res = []

        for offset in range(w):
            left = offset
            have = {}
            count = 0

            for right in range(offset, len(s) - w + 1, w):
                chunk = s[right:right + w]

                if chunk not in need:
                    have = {}
                    count = 0
                    left = right + w
                    continue

                have[chunk] = have.get(chunk, 0) + 1
                count += 1

                while have[chunk] > need[chunk]:
                    drop = s[left:left + w]
                    have[drop] -= 1
                    count -= 1
                    left += w

                if count == k:
                    res.append(left)
                    drop = s[left:left + w]
                    have[drop] -= 1
                    count -= 1
                    left += w

        return res
