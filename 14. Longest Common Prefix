class Solution(object):
    def longestCommonPrefix(self, strs):
        if not strs:
            return ""

        first = strs[0]
        for i in range(len(first)):
            ch = first[i]
            for other in strs[1:]:
                if i == len(other) or other[i] != ch:
                    return first[:i]

        return first
